# Create private values using: python configure.py
SECRET_KEY=GENERATE_SECRET_KEY
POSTGRES_DB=learngraph
POSTGRES_USER=learngraph
POSTGRES_PASSWORD=GENERATE_DATABASE_PASSWORD
DATABASE_URL=postgresql://learngraph:GENERATE_DATABASE_PASSWORD@db:5432/learngraph
REDIS_URL=redis://redis:6379/0
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
PUBLIC_BASE_URL=http://localhost:8000
TRUST_PROXY=False
BRAND_NAME=LearnGraph AI
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AI_DAILY_REQUEST_LIMIT=100
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Production Caddy settings. Configure your real domain and TLS contact email.
DOMAIN=learn.example.com
